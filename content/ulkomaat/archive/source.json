    "body": [
      {
        "_key": "intro0",
        "_type": "block",
        "children": [
          {
            "_key": "intro0s0",
            "_type": "span",
            "marks": [],
            "text": "Kansainvälisen kuljetuksen hinta rakentuu kahdesta osasta: varustamon perimästä lauttamaksusta ja itse kuljetuspalvelusta. Koska Saksassa on useita mahdollisia lähtöpaikkoja, kerromme alla kaksi tapaa, joilla kuljetus voidaan hoitaa — kumpi kannattaa, riippuu siitä, kuinka kaukana noutopaikka on Travemündesta."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "intro1",
        "_type": "block",
        "children": [
          {
            "_key": "intro1s0",
            "_type": "span",
            "marks": [],
            "text": "1. Suora nouto meiltä"
          }
        ],
        "markDefs": [],
        "style": "h2"
      },
      {
        "_key": "intro2",
        "_type": "block",
        "children": [
          {
            "_key": "intro2s0",
            "_type": "span",
            "marks": [],
            "text": "Haemme pyörän suoraan noutopaikalta ja kuljetamme sen läpi koko matkan. Tämä on edullisin ja nopein vaihtoehto, mitä lähempänä noutopaikka on Travemündea — hinta nousee ajomatkan mukana."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "saksanoutohinnat",
        "_type": "priceTable",
        "caption": "Suuntaa-antavia kokonaishintoja Helsinkiin (sis. ALV):",
        "columns": ["Noutoalue Saksassa", "Etäisyys Travemündesta", "Arvioitu kokonaishinta"],
        "rows": [
          {
            "_key": "r0",
            "_type": "row",
            "cells": ["Lyypekki / Hampuri / Kiel", "~60 km", "n. 1 600 €"]
          },
          {
            "_key": "r1",
            "_type": "row",
            "cells": ["Hannover / Bremen / Berliini", "~300 km", "n. 2 150 €"]
          },
          {
            "_key": "r2",
            "_type": "row",
            "cells": ["Ruhrin alue / Köln / Düsseldorf", "~450 km", "n. 2 500 €"]
          },
          {
            "_key": "r3",
            "_type": "row",
            "cells": ["Frankfurt / Kassel / Leipzig / Dresden", "~550 km", "n. 2 750 €"]
          },
          {
            "_key": "r4",
            "_type": "row",
            "cells": ["Stuttgart / Nürnberg / München", "~700 km", "n. 3 100 €"]
          }
        ]
